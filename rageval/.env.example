# rageval environment — copy to `.env` and fill in ONLY what you need.
# The harness runs end-to-end on the MockAdapter with NONE of these set.

# --- LLM-as-judge (answer metrics, M4+) ---
# The provider shim auto-selects from whichever key is present, in this order:
#   OPENAI_API_KEY -> AZURE_OPENAI_* -> ANTHROPIC_API_KEY
# If none are set, judge-based metrics are simply skipped (run still succeeds).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# Override the judge model name (defaults per provider):
# RAGEVAL_JUDGE_MODEL=

# --- SuperBot adapter (M7, extra: rageval[superbot]) ---
# base_url/thread_id live in the target config (configs/superbot.yaml); only the
# credentials are read from here. Provide EITHER a pre-issued token OR email+password.
# SUPERBOT_TOKEN=
# SUPERBOT_EMAIL=
# SUPERBOT_PASSWORD=

# --- Tracing (M5, extra: rageval[tracing]) — degrades to local JSON when unset ---
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
