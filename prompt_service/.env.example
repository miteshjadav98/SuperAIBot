# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=prompt_management

# Optional: enable shared Redis caching (omit to use in-process TTL cache)
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

LOG_LEVEL=INFO

# Path prefix when served behind a reverse proxy that strips it (Azure VM
# nginx uses /prompt-api). Leave empty for local development.
# ROOT_PATH=/prompt-api

# When set, all /prompts endpoints require this value in the X-API-Key header.
# Swagger UI shows an Authorize button for it. Strongly recommended in prod.
# PROMPT_API_KEY=change-me

